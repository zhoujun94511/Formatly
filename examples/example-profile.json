{
  "id": "my-school-example",
  "name": "我的学校 · 示例规则（请按实际规范修改）",
  "description": "演示A4纸型、25毫米页边距及Normal正文样式。此文件是配置示例，不代表任何学校的正式要求。",
  "plugins": [
    "docx-package",
    "generic-format"
  ],
  "settings": {
    "page": {
      "width_mm": 210,
      "height_mm": 297,
      "tolerance_mm": 1,
      "margins_mm": {
        "top": 25,
        "bottom": 25,
        "left": 25,
        "right": 25
      }
    },
    "required_headings": [
      "摘要",
      "参考文献"
    ],
    "body": {
      "style_ids": [
        "Normal"
      ],
      "font": "宋体",
      "size_pt": 12,
      "line_spacing": 1.5
    }
  }
}
