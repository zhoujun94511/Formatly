{
  "name": "formatly-frontend",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-report.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --import ./tests/register-typescript.mjs --experimental-test-isolation=none --test ./tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vue-tsc": "3.3.14"
  }
}
